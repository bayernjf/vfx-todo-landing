---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/AboutContent.astro';
import TechStack from '../components/TechStack.astro';
import { ui } from '../i18n/ui';
import { aboutPageJsonLd } from '../i18n/jsonld';

const lang = 'zh' as const;
const d = ui[lang];
const jsonLd = aboutPageJsonLd(lang);
const title = `${d['nav.about']} — VFX Todo`;
---
<BaseLayout lang={lang} title={title} description={d['about.subtitle']} path="/about" jsonLd={jsonLd}>
  <AboutContent lang={lang} />
  <TechStack lang={lang} />
</BaseLayout>
