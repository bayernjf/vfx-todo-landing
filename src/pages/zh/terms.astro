---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/ui';

const lang = 'zh' as const;
const d = ui[lang];
const title = `${d['footer.terms']} | VFX Todo`;
const description = 'VFX Todo 服务条款：使用本站与本站点内容的相关约定。';
---
<BaseLayout lang={lang} title={title} description={description} path="/zh/terms">
  <section class="container-prose py-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-bold text-ink sm:text-4xl">服务条款</h1>
      <p class="mt-3 text-sm text-ink-muted">最后更新：2026 年 8 月 7 日 · 生效日期：2026 年 8 月 7 日</p>

      <div class="prose-tight mt-8">
        <h2>1. 接受条款</h2>
        <p>
          欢迎访问 VFX Todo 产品介绍站点（下称「本站」）。访问或使用本站即表示你同意受本条款约束。如不同意，请停止使用本站。
        </p>

        <h2>2. 站点内容</h2>
        <p>
          本站内容为 VFX Todo 产品的介绍、截图与下载说明，按「现状」提供，可能随产品迭代发生变化。功能描述与安装包信息以 GitHub 仓库中的实际版本为准。我们努力保证信息准确，但不对内容的完整性、时效性作任何明示或暗示的保证。
        </p>

        <h2>3. 知识产权</h2>
        <p>
          VFX Todo 是开源项目，源代码按仓库中声明的 MIT 许可证发布。本站的文案、设计与标识归项目方所有，未经许可不得用于商业目的。
        </p>

        <h2>4. 合理使用</h2>
        <p>
          请勿以任何可能损害、干扰本站运行或侵犯他人权益的方式使用本站，包括但不限于恶意爬取、注入攻击或冒充本站身份。
        </p>

        <h2>5. 责任限制</h2>
        <p>
          在法律允许的最大范围内，本站不对因使用或无法使用本站内容（包括下载与安装 VFX Todo）而产生的任何间接、附带或后果性损失承担责任。
        </p>

        <h2>6. 条款变更</h2>
        <p>
          本条款可能更新，变更将在本页发布。继续使用本站即视为接受更新后的条款。
        </p>

        <h2>7. 联系方式</h2>
        <p>
          如有疑问，请通过
          <a href="https://github.com/bayernjf/vfx-todo" target="_blank" rel="noopener noreferrer" class="font-medium text-brand hover:text-brand-dark">GitHub 仓库</a>
          的 Issues 与我们联系。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
