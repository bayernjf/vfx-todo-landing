---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import EffectGrid from '../../components/EffectGrid.astro';
import TechStack from '../../components/TechStack.astro';
import { ui } from '../../i18n/ui';
import { softwareApplicationJsonLd } from '../../i18n/jsonld';

const lang = 'zh' as const;
const d = ui[lang];
const jsonLd = softwareApplicationJsonLd(lang);
const title = `${d['nav.features']} | VFX Todo`;
const altEffects = lang === 'zh' ? 'VFX Todo 的 8 种视觉特效展示' : 'The 8 visual effects of VFX Todo';
const altUi = lang === 'zh' ? 'VFX Todo 应用界面' : 'VFX Todo application interface';
---
<BaseLayout lang={lang} title={title} description={d['features.subtitle']} path="/zh/features" jsonLd={jsonLd}>
  <FeatureGrid lang={lang} />
  <EffectGrid lang={lang} />
  <section class="container-prose py-16">
    <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
      <img src="/screenshots/effects.jpg" alt={altEffects} width="1152" height="864" loading="lazy" class="w-full" />
    </div>
    <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 shadow-sm">
      <img src="/screenshots/app-ui.jpg" alt={altUi} width="1152" height="864" loading="lazy" class="w-full" />
    </div>
  </section>
  <TechStack lang={lang} />
</BaseLayout>
