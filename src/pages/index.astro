---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import EffectGrid from '../components/EffectGrid.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FaqList from '../components/FaqList.astro';
import { ui } from '../i18n/ui';
import { softwareApplicationJsonLd } from '../i18n/jsonld';

const lang = 'en' as const;
const d = ui[lang];
const jsonLd = softwareApplicationJsonLd(lang);
---
<BaseLayout lang={lang} title={d['site.title']} description={d['site.desc']} path="/" jsonLd={jsonLd}>
  <HeroSection lang={lang} />
  <EffectGrid lang={lang} />
  <FeatureGrid lang={lang} variant="preview" />
  <FaqList lang={lang} variant="preview" />
</BaseLayout>
