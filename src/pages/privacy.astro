---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';

const lang = 'en' as const;
const d = ui[lang];
const title = `${d['footer.privacy']} | VFX Todo`;
const description = 'Privacy Policy of VFX Todo: how we handle information related to your visit.';
---
<BaseLayout lang={lang} title={title} description={description} path="/privacy">
  <section class="container-prose py-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-bold text-ink sm:text-4xl">Privacy Policy</h1>
      <p class="mt-3 text-sm text-ink-muted">Last updated: August 7, 2026 · Effective: August 7, 2026</p>

      <div class="prose-tight mt-8">
        <h2>1. Overview</h2>
        <p>
          VFX Todo is an open-source desktop todo app with visual effects, and this site (vfx-todo.bayjf.com) is its product introduction and download website. We respect and protect the privacy of our visitors. This policy explains how information related to your visit is handled. By using the Site you agree to the terms of this policy.
        </p>

        <h2>2. Information We Handle</h2>
        <ul>
          <li>The Site is static, offers no account registration, and does not actively collect personally identifiable information such as names or email addresses.</li>
          <li>The hosting platform (Cloudflare Pages) may record basic access logs (IP address, User-Agent, etc.) under its own policies, outside our control.</li>
          <li>If analytics are enabled in the future, only anonymized usage statistics (page views, referrers, etc.) will be used, never to identify individuals.</li>
          <li>The VFX Todo desktop app itself stores your todo data locally on your device as a JSON file; it is never uploaded to this Site.</li>
        </ul>

        <h2>3. Cookies & Local Storage</h2>
        <p>
          The Site may use browser cookies or localStorage to remember interface preferences such as language. These are used solely to improve browsing and never for cross-site tracking. You can disable or clear them in your browser settings.
        </p>

        <h2>4. Third-Party Links</h2>
        <p>
          The Site contains links to third-party websites such as GitHub (source code and installer downloads). Their privacy practices are not covered by this policy; please refer to their own policies.
        </p>

        <h2>5. Children</h2>
        <p>The Site is not directed at children under 14, and we do not knowingly collect personal information from them.</p>

        <h2>6. Changes</h2>
        <p>
          This policy may be updated as the product evolves. Changes will be posted on this page with an updated revision date.
        </p>

        <h2>7. Contact</h2>
        <p>
          Questions about this policy can be raised via Issues on our
          <a href="https://github.com/bayernjf/vfx-todo" target="_blank" rel="noopener noreferrer" class="font-medium text-brand hover:text-brand-dark">GitHub repository</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
