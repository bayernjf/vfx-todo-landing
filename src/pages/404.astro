---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';

const lang = 'en' as const;
const d = ui[lang];
const title = `404: Page Not Found | VFX Todo`;
const description = 'The page you are looking for does not exist or has been moved.';
---
<BaseLayout lang={lang} title={title} description={description} path="/404">
  <section class="container-prose py-24 text-center md:py-32">
    <p class="font-mono text-sm uppercase tracking-widest text-brand">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink sm:text-4xl">Page Not Found</h1>
    <p class="mt-3 text-ink-muted">{description}</p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/download" class="btn-ghost">{d['nav.download']}</a>
    </div>
  </section>
</BaseLayout>
