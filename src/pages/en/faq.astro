---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import { ui } from '../../i18n/ui';
import { faqPageJsonLd } from '../../i18n/jsonld';

const lang = 'en' as const;
const d = ui[lang];
const jsonLd = faqPageJsonLd(lang);
const title = `${d['nav.faq']} | VFX Todo`;
---
<BaseLayout lang={lang} title={title} description={d['faq.subtitle']} path="/en/faq" jsonLd={jsonLd}>
  <FaqList lang={lang} />
</BaseLayout>
