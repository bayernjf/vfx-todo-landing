---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { getFaqs } from '../i18n/content';

export interface Props {
  lang: Lang;
  variant?: 'full' | 'preview';
}
const { lang, variant = 'full' } = Astro.props;
const d = ui[lang];
const all = getFaqs(lang);
const faqs = variant === 'preview' ? all.slice(0, 3) : all;
---
<section class="container-prose py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold text-ink">{d['faq.title']}</h2>
    <p class="mt-3 text-ink-soft">{d['faq.subtitle']}</p>
  </div>
  <div class="mx-auto mt-10 max-w-3xl space-y-3">
    {faqs.map((f) => (
      <details class="group rounded-lg border border-slate-200 bg-white p-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-ink">
          <span>{f.q}</span>
          <span class="mt-0.5 text-brand transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{f.a}</p>
      </details>
    ))}
  </div>
</section>
