---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = ui[lang];
const paras = [d['about.p1'], d['about.p2'], d['about.p3']];
---
<section class="container-prose py-16">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">{d['about.title']}</h1>
    <p class="mt-3 text-lg text-ink-soft">{d['about.subtitle']}</p>
    <div class="prose-tight mt-8">
      {paras.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </div>
</section>
