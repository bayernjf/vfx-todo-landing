---
import type { Lang } from '../i18n/ui';
import { getEffectNames } from '../i18n/content';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const names = getEffectNames(lang);
const title = lang === 'zh' ? '8 种视觉特效' : '8 Visual Effects';
const subtitle = lang === 'zh' ? '按任务等级智能路由,WebGL 着色器实时渲染' : 'Intelligently routed by task level, rendered in real time with WebGL shaders';

const gradients = [
  'from-violet-500 to-purple-600',
  'from-sky-400 to-blue-600',
  'from-rose-400 to-pink-600',
  'from-emerald-400 to-teal-600',
  'from-amber-400 to-orange-600',
  'from-cyan-400 to-blue-500',
  'from-fuchsia-500 to-purple-700',
  'from-red-400 to-rose-600',
];
---
<section class="bg-slate-50 py-16">
  <div class="container-prose">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink">{title}</h2>
      <p class="mt-3 text-ink-soft">{subtitle}</p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {names.map((name, i) => (
        <div class={`group relative overflow-hidden rounded-xl bg-gradient-to-br ${gradients[i % gradients.length]} p-5 text-white shadow-sm transition hover:shadow-lg`}>
          <div class="text-lg font-semibold">{name}</div>
          <div class="mt-1 text-xs font-mono uppercase tracking-wider opacity-70">0{i + 1}</div>
        </div>
      ))}
    </div>
  </div>
</section>
