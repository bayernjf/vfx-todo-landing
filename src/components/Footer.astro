---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { getNavItems } from '../i18n/content';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = ui[lang];
const navItems = getNavItems(lang).map((i) => ({ label: i.label, href: localizedPath(lang, i.href) }));
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="container-prose grid grid-cols-1 gap-8 py-12 sm:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 font-bold text-ink">
        <span class="inline-block h-6 w-6 rounded bg-brand"></span>
        <span>VFX Todo</span>
      </div>
      <p class="mt-3 text-sm text-ink-muted">{d['footer.tagline']}</p>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-ink">{d['footer.links']}</h3>
      <ul class="space-y-2 text-sm">
        {navItems.map((item) => (
          <li><a href={item.href} class="text-ink-muted transition hover:text-brand">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-ink">{d['footer.resources']}</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="https://github.com/bayernjf/vfx-todo" target="_blank" rel="noopener noreferrer" class="text-ink-muted transition hover:text-brand">GitHub</a></li>
        <li><a href="https://bayjf.com" target="_blank" rel="noopener noreferrer" class="text-ink-muted transition hover:text-brand">BayJF</a></li>
        <li><a href="/llms.txt" class="text-ink-muted transition hover:text-brand">llms.txt</a></li>
        <li><a href="/sitemap-index.xml" class="text-ink-muted transition hover:text-brand">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 text-center text-xs text-ink-muted">
    © {year} {d['footer.copyright']}
  </div>
</footer>
